{
	"schemaVersion": 1,
	"id": "autyism-deathreplay",
	"version": "${version}",
	"name": "Death Replay",
	"description": "Rewatch the last seconds before you died (30 by default) in third person, first person or a free camera, save replays to files, and look around freely on the death screen. Client-side only: it records what your game already receives and sends nothing to the server.",
	"authors": [
		"Autyism"
	],
	"contact": {
		"homepage": "https://github.com/Autyism/DeathReplay",
		"sources": "https://github.com/Autyism/DeathReplay",
		"issues": "https://github.com/Autyism/DeathReplay/issues"
	},
	"license": "GPL-3.0-only",
	"icon": "assets/deathreplay/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"io.github.autyism.deathreplay.DeathReplayClient"
		],
		"modmenu": [
			"io.github.autyism.deathreplay.config.ModMenuIntegration"
		]
	},
	"mixins": [
		"deathreplay.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	},
	"breaks": {
		"deathreplay": "*"
	}
}
